# Example only. Set these in the Python host's secret environment settings.
# This service does not auto-load .env files. Never upload a real .env to Git.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=recruitment@example.com
SMTP_PASSWORD=
SMTP_FROM=recruitment@example.com
CAREERS_ALLOWED_ORIGINS=https://www.waikwantent.com
# Persistent private disk, outside this repository and outside the web root.
CAREERS_DB_PATH=/var/lib/waikwan-careers/receipts.sqlite3
# Python host start command: gunicorn --bind 0.0.0.0:$PORT --workers 1 --threads 4 careers_backend.app:application
# SMTP_SECURITY supports starttls (587) or ssl (465); no plaintext mode.
