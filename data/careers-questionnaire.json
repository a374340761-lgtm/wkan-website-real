        },
        {
          "key": "learn",
          "label": "最希望先学习的环节",
          "type": "select",
          "options": [
            {
              "value": "product",
              "label": "产品与使用场景"
            },
            {
              "value": "research",
              "label": "客户与市场开发"
            },
            {
              "value": "english",
              "label": "英文沟通"
            },
            {
              "value": "quote",
              "label": "报价与订单全流程"
            },
            {
              "value": "unsure",
              "label": "还不确定，想先了解"
            }
          ]
        }
      ]
