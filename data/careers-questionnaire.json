          "options": [
            {
              "value": "product",
              "label": "产品学习"
            },
            {
              "value": "research",
              "label": "客户开发"
            },
            {
              "value": "english",
              "label": "英文沟通"
            },
            {
              "value": "quote",
              "label": "报价"
            },
            {
              "value": "orders",
              "label": "跟单与生产进度"
            },
            {
              "value": "shipment",
              "label": "出货和售后"
            },
            {
              "value": "new",
              "label": "刚开始了解"
            }
